[Unit]
Description=Rebound agent fix loop (acts only on breakages unresolved after 30 min)
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/rebound-twitch
EnvironmentFile=-%h/.config/rebound-twitch/monitor.env
ExecStart=/bin/bash -lc 'exec node agent/orchestrate.js'
TimeoutStartSec=3h
