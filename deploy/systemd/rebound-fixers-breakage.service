[Unit]
Description=Rebound deterministic fixers (started by the monitor on a confirmed breakage)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/rebound-twitch
EnvironmentFile=-%h/.config/rebound-twitch/monitor.env
ExecStart=/bin/bash -lc 'exec node fixers/run.js --trigger breakage'
TimeoutStartSec=50min
